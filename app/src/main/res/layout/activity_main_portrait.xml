<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部车辆连接与设备身份卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card_cockpit"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="壹酷 · 封神DZ"
                    android:textColor="@color/text_title"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_device_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="加长锂电版 · 60V 平安700智控旗舰"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_conn_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_capsule_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/tv_status_dot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="@color/red"
                    android:textSize="11sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tv_conn_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="等待连接"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 赛道级极光仪表舱 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_cockpit"
            android:layout_marginTop="12dp"
            android:padding="18dp">

            <!-- 速度与档位展示 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="实时车速"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_marginTop="2dp">

                        <TextView
                            android:id="@+id/tv_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/text_title"
                            android:textSize="56sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" KM/H"
                            android:textColor="@color/text_dim"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="6dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 当前动力档位胶囊 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_cockpit_inner"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="动力档位"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_gear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="P 档"
                        android:textColor="@color/amber"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 四象限行车数据矩阵 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="母线电压" android:textColor="@color/text_dim" android:textSize="11sp" />
                    <TextView android:id="@+id/tv_voltage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--.- V" android:textColor="@color/cyan" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="剩余电量" android:textColor="@color/text_dim" android:textSize="11sp" />
                    <TextView android:id="@+id/tv_battery" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-- %" android:textColor="@color/green" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="单次里程" android:textColor="@color/text_dim" android:textSize="11sp" />
                    <TextView android:id="@+id/tv_once_trip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.0 km" android:textColor="@color/text_main" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="2dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="整车总计" android:textColor="@color/text_dim" android:textSize="11sp" />
                    <TextView android:id="@+id/tv_total_trip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 km" android:textColor="@color/text_main" android:textSize="18sp" android:textStyle="bold" android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 车辆自检与状态指示栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_card_cockpit_inner"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tv_error_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="整车系统自检正常"
                    android:textColor="@color/green"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/badge_limit_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25 km/h 限速"
                    android:textColor="@color/cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 主控能量启停环（取代土味红绿双拼方块，九号一键启动核心） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_card_cockpit"
            android:layout_marginTop="12dp"
            android:paddingVertical="18dp">

            <FrameLayout
                android:id="@+id/btn_power_core"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_power_ring_off"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_power_core_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="START"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tv_power_core_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点击上电"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 隐藏的传统按钮 ID，确保完全兼容原有逻辑 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">
                <Button android:id="@+id/btn_power_on" android:layout_width="0dp" android:layout_height="0dp" />
                <Button android:id="@+id/btn_power_off" android:layout_width="0dp" android:layout_height="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 快捷控车悬浮胶囊栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btn_lock_toggle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="锁车设防"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/amber"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_speed_limit_toggle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="极速模式"
                android:textColor="#08101A"
                android:backgroundTint="@color/cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_seek_vehicle"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="鸣笛寻车"
                android:textColor="@color/text_main"
                android:backgroundTint="@color/bg_card_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- AirLock 无感互联舱 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AirLock 无感互联与安防"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_cockpit"
            android:padding="16dp">

            <!-- 感应解锁 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="感应解锁 (AirLock)"
                        android:textColor="@color/text_main"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="手机靠近车辆自动撤防并启动电门"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_proximity_unlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="4dp" />

            <!-- 离车自动设防 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="离车自动设防"
                        android:textColor="@color/text_main"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="离车离开蓝牙范围自动锁车断电"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_auto_lock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="4dp" />

            <!-- 超速警示音 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="超速警示音"
                        android:textColor="@color/text_main"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="车速超过限定时发出蜂鸣警示"
                        android:textColor="@color/text_dim"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_overspeed_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="8dp" />

            <!-- 靠近感应距离档位 (1~7 级) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="感应解锁触发距离" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 档 (最近) ~ 7 档 (最远)" android:textColor="@color/text_dim" android:textSize="11sp" android:layout_marginTop="2dp" />
                </LinearLayout>
                <TextView android:id="@+id/tv_distance_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4 档" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_distance_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="6"
                android:progress="3"
                android:layout_marginTop="8dp" />

            <!-- 防盗震动灵敏度 (1~4 级) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="防盗报警灵敏度" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 级 (适中) ~ 4 级 (灵敏)" android:textColor="@color/text_dim" android:textSize="11sp" android:layout_marginTop="2dp" />
                </LinearLayout>
                <TextView android:id="@+id/tv_sensitivity_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2 级" android:textColor="@color/amber" android:textStyle="bold" android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_sensitivity_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="3"
                android:progress="1"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 动力与骑行调校 (RideyFun 控制台) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="动力性能与骑行调校"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_cockpit"
            android:padding="16dp">

            <!-- TCS 开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TCS 牵引力控制系统" android:textColor="@color/text_main" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="湿滑路面起步驱动轮防打滑与侧滑" android:textColor="@color/text_dim" android:textSize="11sp" android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_ecu_tcs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="4dp" />

            <!-- 动力启动模式 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="弹射硬启动模式" android:textColor="@color/text_main" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开启为硬启动提速响应，关闭为平顺起步" android:textColor="@color/text_dim" android:textSize="11sp" android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_ecu_start_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="4dp" />

            <!-- 陡坡缓降与坡道驻车 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="陡坡缓降 (HDC) 与坡道驻车" android:textColor="@color/text_main" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="陡坡恒速制动，坡道防后溜驻车保护" android:textColor="@color/text_dim" android:textSize="11sp" android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_ecu_hdc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="4dp" />

            <!-- 推行/倒车辅助 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="推行与倒车助力" android:textColor="@color/text_main" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="支持推行助力与倒车低速电动辅助" android:textColor="@color/text_dim" android:textSize="11sp" android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_ecu_assist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="4dp" />

            <!-- P档驻车保护 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P 档驻车安全保护" android:textColor="@color/text_main" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="驻车状态防误拧转把飞车保护" android:textColor="@color/text_dim" android:textSize="11sp" android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_ecu_p_gear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="4dp" />

            <!-- EBS 动能回收开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingVertical="6dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="EBS 能量回收制动" android:textColor="@color/text_main" android:textSize="14sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="刹车制动反充，减少刹车皮磨损" android:textColor="@color/text_dim" android:textSize="11sp" android:layout_marginTop="2dp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_ecu_ebs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="能量回收制动力矩强度" android:textColor="@color/text_secondary" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/tv_ebs_current_val" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="128" android:textColor="@color/cyan" android:textStyle="bold" android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/seek_ebs_current"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="255"
                android:progress="128"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_apply_ecu"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="同步参数至车辆控制器"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/blue"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 电池系统规格 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="电池系统规格校准"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btn_volt_48v"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="48V 锂电"
                android:textColor="@color/text_main"
                android:backgroundTint="@color/bg_card_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_volt_60v"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="60V 锂电 (标配)"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/cyan_dim"
                android:textStyle="bold"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_volt_72v"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="72V 锂电"
                android:textColor="@color/text_main"
                android:backgroundTint="@color/bg_card_secondary"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
